# Supabase Configuration for Cashly
# Copy this file to .env and fill in your project values.
# NEVER commit .env to Git - it is in .gitignore.

# ============================================================
# SUPABASE PROJECT
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================
# PHASE 32-34: EDGE FUNCTION SECRETS
# Set via Supabase Dashboard: Project Settings -> Edge Functions -> Secrets
# NEVER commit to Git or expose to the browser.
# ============================================================

# Supabase service-role key (server-side only - NEVER expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================
# PHASE 33-34: RAZORPAY TEST MODE SECRETS
# SINGLE-MERCHANT RAZORPAY TEST MODE ONLY.
# All four values must be set as Supabase Edge Function secrets.
# ============================================================

# Razorpay API Key ID (starts with rzp_test_ in Test Mode)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx

# Razorpay API Key Secret (PRIVATE - never expose to browser or logs)
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Merchant Account ID (Razorpay Dashboard -> Settings -> Business Profile)
# Format: acc_xxxxxxxxxxxxxxxx
# RAZORPAY_MERCHANT_ID=acc_xxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret (set when registering webhook URL in Razorpay Dashboard)
# Used for HMAC-SHA256 signature verification.
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ============================================================
# PHASE 32: MOCK/DEMO PROVIDER
# ============================================================

# Mock provider webhook secret (for testing without live Razorpay credentials)
# MOCK_PROVIDER_WEBHOOK_SECRET=your_mock_webhook_secret_here

# Mock provider API key (for testing provider-token-exchange)
# MOCK_PROVIDER_API_KEY=your_mock_api_key_here