# Supabase Configuration for Cashly
# Paste your Supabase Project URL and Anon Key below:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ============================================================
# PHASE 32: EDGE FUNCTION SECRETS
# These values MUST be set via Supabase Dashboard → Project Settings → Edge Functions → Secrets
# They must NEVER be committed to Git or exposed to the frontend.
# ============================================================

# Service-role key for Edge Functions (server-side only — NEVER expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Mock provider webhook secret (used for HMAC-SHA256 signature verification)
# Replace with real provider secret (Plaid, Stripe, etc.) in Phase 33.
# MOCK_PROVIDER_WEBHOOK_SECRET=your_mock_webhook_secret_here

# Mock provider API key for token exchange (not used until Phase 33)
# MOCK_PROVIDER_API_KEY=your_mock_api_key_here
